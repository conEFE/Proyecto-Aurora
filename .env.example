# Copie a .env.local (no se versiona). URL del backend FastAPI.
VITE_API_URL=http://localhost:8000

# Límite mostrado en la interfaz (debe coincidir con MAX_UPLOAD_MB del backend)
VITE_MAX_UPLOAD_MB=60

# Compresión opcional en el navegador (mitigación INC-04). Desactivada: re-codificar a JPEG pierde información.
VITE_CLIENT_COMPRESSION=false
VITE_COMPRESSION_THRESHOLD_MB=20

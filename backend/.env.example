# Copie este archivo a backend/.env y complete los valores. NUNCA versione backend/.env.

# Conexión a PostgreSQL (>= 14)
DB_DSN=postgresql+psycopg2://aurora:CAMBIAR@localhost:5432/aurora

# Clave para firmar los JWT. Obligatoria. Genere una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Minutos de validez del token de acceso
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Orígenes permitidos por CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Almacenamiento de imágenes cifradas (Fernet). Genere la clave con: python generate_key.py
FILES_DIR=./data/images
ENCRYPTION_KEY=
MAX_UPLOAD_MB=60

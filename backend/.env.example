# Copie este archivo a backend/.env y complete los valores. NUNCA versione backend/.env.

# Conexión a PostgreSQL (>= 14)
DB_DSN=postgresql+psycopg2://aurora:CAMBIAR@localhost:5432/aurora

# Clave para firmar los JWT. Obligatoria, mínimo 32 caracteres. Genere una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Minutos de validez del token de acceso
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Orígenes permitidos por CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Almacenamiento de imágenes cifradas (Fernet). Genere la clave con: python generate_key.py
FILES_DIR=./data/images
ENCRYPTION_KEY=
MAX_UPLOAD_MB=60

# Proveedor de inferencia: simulated (marca todo resultado como IA SIMULADA) o http (servicio YOLO)
INFERENCE_PROVIDER=simulated
INFERENCE_URL=http://localhost:8080

# Dashboard: guardar la duración de cada request (p95) y umbral de casos ALTA pendientes (horas)
REQUEST_METRICS_ENABLED=true
ALTA_PENDING_HOURS=24

# Seguridad de cuentas
# Largo mínimo de contraseña (además: letras y números, distinta de la actual y sin el RUT)
PASSWORD_MIN_LENGTH=10
# Intentos fallidos seguidos antes de bloquear la cuenta y minutos de bloqueo
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Intentos de login por IP por minuto (en memoria, por proceso)
LOGIN_RATE_LIMIT_PER_MINUTE=10
# true solo si la API está detrás de un proxy propio que agrega X-Forwarded-For
TRUST_PROXY_HEADERS=false
# Documentación interactiva /docs y /openapi.json (desactivar en producción)
ENABLE_API_DOCS=true

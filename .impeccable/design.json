      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 16px;border:0;border-radius:8px;background:hsl(var(--primary,333 78% 42%));color:#fff;font:600 0.9375rem/1.4rem \"Atkinson Hyperlegible Next Variable\",system-ui,sans-serif;cursor:pointer;transition:background-color .15s}.ds-btn-primary:hover{background:hsl(var(--primary,333 78% 42%) / .9)}.ds-btn-primary:active{background:hsl(var(--primary,333 78% 42%) / .8)}.ds-btn-primary:focus-visible{outline:2px solid hsl(var(--ring,333 78% 42%));outline-offset:2px}"

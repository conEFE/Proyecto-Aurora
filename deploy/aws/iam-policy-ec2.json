{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ImagenesYRespaldosEnS3",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::NOMBRE_DEL_BUCKET/images/*",
        "arn:aws:s3:::NOMBRE_DEL_BUCKET/backups/*"
      ]
    },
    {
      "Sid": "ListarSoloLosPrefijosDeAurora",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::NOMBRE_DEL_BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "images/*",
            "backups/*"
          ]
        }
      }
    },
    {
      "Sid": "LogsEnCloudWatch",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": "arn:aws:logs:REGION:ID_DE_CUENTA:log-group:/aurora/*"
    }
  ]
}

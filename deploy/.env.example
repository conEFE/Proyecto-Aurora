# Configuración de Docker Compose (local o EC2). Copie a deploy/.env y complete. NUNCA versione deploy/.env.
# Genere cada secreto con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# y ENCRYPTION_KEY con:     python backend/generate_key.py

# --- Imágenes de contenedor ---------------------------------------------------------------------
# Local: se construyen con --build. En EC2 conviene descargar las publicadas por GitHub Actions
# (workflow «Publicar imágenes»): AURORA_IMAGE_PREFIX=ghcr.io/<usuario>/proyecto-aurora y AURORA_VERSION=v2.5.0
AURORA_IMAGE_PREFIX=aurora
AURORA_VERSION=local

# --- Base de datos ---------------------------------------------------------------------------
# Local / EC2 con PostgreSQL en contenedor: deje COMPOSE_PROFILES=db y defina POSTGRES_PASSWORD.
# Con Amazon RDS: borre COMPOSE_PROFILES y defina DB_DSN apuntando a RDS (con ?sslmode=require).
COMPOSE_PROFILES=db
POSTGRES_PASSWORD=
# DB_DSN=postgresql+psycopg2://aurora:CLAVE@aurora-db.xxxxxxxx.sa-east-1.rds.amazonaws.com:5432/aurora?sslmode=require

# --- Secretos de la API ----------------------------------------------------------------------
SECRET_KEY=
ENCRYPTION_KEY=

# --- Sitio -----------------------------------------------------------------------------------
# Local: SITE_ADDRESS=:80 y PUBLIC_URL=http://localhost:8080
# Producción: SITE_ADDRESS=aurora.midominio.cl y PUBLIC_URL=https://aurora.midominio.cl
SITE_ADDRESS=:80
PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080

# --- Imágenes ----------------------------------------------------------------------------------
# local: volumen de Docker (cifrado por la aplicación). s3: bucket con SSE-KMS (recomendado en AWS).
STORAGE_BACKEND=local
S3_BUCKET=
S3_PREFIX=images/
S3_KMS_KEY_ID=
AWS_REGION=sa-east-1
MAX_UPLOAD_MB=60

# --- Seguridad y operación ---------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=10
# La API va detrás de Caddy, que agrega X-Forwarded-For
TRUST_PROXY_HEADERS=true
# Un solo worker: el límite de intentos por IP vive en memoria de cada proceso
WEB_CONCURRENCY=1
INFERENCE_PROVIDER=simulated
CLOUDWATCH_LOG_GROUP=/aurora/prod

# --- Primer ADMIN (python init_user.py dentro del contenedor backend) ------------------------
AURORA_ADMIN_RUT=
AURORA_ADMIN_EMAIL=
AURORA_ADMIN_NAME=
AURORA_ADMIN_PASSWORD=
BACKUP_BUCKET=
